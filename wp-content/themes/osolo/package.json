{
  "private": true,
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=development run-s mix",
    "build:production": "cross-env NODE_ENV=production run-s clean mix",
    "start": "cross-env NODE_ENV=development run-s 'mix --watch'",
    "hot": "cross-env NODE_ENV=development run-s build mix:hot",
    "mix": "webpack --progress --config=node_modules/laravel-mix/setup/webpack.config.js",
    "mix:hot": "webpack-dev-server --inline --hot --config=node_modules/laravel-mix/setup/webpack.config.js",
    "clean": "run-p clean:*",
    "clean:dist": "rimraf dist",
    "clean:cache": "rimraf storage/framework/cache/*.php storage/framework/cache/data/*.php",
    "clean:views": "rimraf storage/framework/views/*.php",
    "lint": "run-s -c lint:*",
    "lint:scripts": "eslint resources/scripts",
    "lint:styles": "stylelint \"resources/**/*.{vue,css,sass,scss,less}\"",
    "test": "run-s -c lint"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.1",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@tsconfig/recommended": "^1.0.7",
    "@types/jquery": "^3.5.30",
    "@types/wordpress__blocks": "^12.5.14",
    "@types/wordpress__edit-post": "^7.5.7",
    "@wordpress/babel-preset-default": "^8.4.0",
    "@wordpress/blocks": "^13.4.0",
    "@wordpress/browserslist-config": "^6.4.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.4.0",
    "@wordpress/dom-ready": "^4.4.0",
    "@wordpress/edit-post": "^8.4.0",
    "browser-sync": "^3.0.2",
    "browser-sync-webpack-plugin": "^2.3.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "error-overlay-webpack-plugin": "^1.1.1",
    "eslint": "^9.8.0",
    "eslint-plugin-import": "^2.29.1",
    "laravel-mix": "^6.0.49",
    "laravel-mix-compress": "^3.0.0",
    "laravel-mix-copy-watched": "^3.0.0",
    "laravel-mix-purgecss": "^6.0",
    "npm-run-all": "^4.1.5",
    "purgecss-with-wordpress": "^6.0.0",
    "rimraf": "^6.0.1",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.0",
    "stylelint": "^16.8.1",
    "stylelint-config-css-modules": "^4.4.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "ts-loader": "^8.0.0",
    "typescript": "^5.5.4",
    "vue-template-compiler": "^2.7.16"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@splidejs/splide": "^4.1.4",
    "animejs": "^3.2.1",
    "bootstrap": "^5.3.3",
    "gsap": "^3.12.5",
    "imagesloaded": "^5.0.0",
    "locomotive-scroll": "^4.1.4",
    "split-type": "^0.3.4"
  }
}
